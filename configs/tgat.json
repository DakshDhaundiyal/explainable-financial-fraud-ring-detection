  "data": {
    "directory": "data/processed/temporal_gnn_v2_1s",
    "timestamp_resolution_seconds": 1,
    "train": "train.csv",
    "validation": "validation.csv",
    "test": "test.csv",
    "future": "future.csv"
  },
  "results": "results/research_validation/corrected_tgat"
}
